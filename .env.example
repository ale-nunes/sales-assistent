# Copy this file to .env. Never commit .env or real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Gmail OAuth: create credentials in Google Cloud Console later in Phase 4/6.
GMAIL_CLIENT_SECRETS_FILE=secrets/gmail-client-secrets.json
GMAIL_TOKEN_FILE=.local/gmail-token.json
GMAIL_READ_ONLY=true
GMAIL_ALLOW_DRAFT_CREATION=false

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=.local/researchmind.sqlite3
CHROMA_PATH=.local/chroma
EMBEDDING_CACHE_PATH=.local/embedding_cache.sqlite3
DOCUMENTS_PATH=data/raw
MAX_CRITIC_ITERATIONS=3
REQUEST_TIMEOUT_SECONDS=45
MAX_REQUESTS_PER_MINUTE=8
